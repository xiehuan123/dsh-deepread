            "explanation": { "type": "string" },
            "gaps": { "type": "array", "items": { "type": "string" } },
            "corrections": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "bookMap": { "type": "string" },
      "finalExplanation": { "type": "string" },
      "reviewPlan": {
        "type": "array",
        "items": {
          "type": "object",
